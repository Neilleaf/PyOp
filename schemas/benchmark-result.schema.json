{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pyop:benchmark-result:1.0",
  "title": "PyOp benchmark result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "input_size", "python_version", "repetitions", "warmups", "status", "variants", "errors"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark_id": {"type": "string"},
    "input_size": {"type": ["integer", "null"]},
    "python_version": {"type": "string", "minLength": 1},
    "repetitions": {"type": "integer"},
    "warmups": {"type": "integer"},
    "status": {"enum": ["ok", "error"]},
    "variants": {"type": "array", "items": {"$ref": "#/$defs/variant"}},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}}
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "ok"}}},
    "then": {"properties": {
      "benchmark_id": {"enum": ["duplicates", "fibonacci"]},
      "input_size": {"type": "integer", "minimum": 0},
      "repetitions": {"minimum": 1, "maximum": 30},
      "warmups": {"minimum": 0, "maximum": 5},
      "variants": {"minItems": 2, "maxItems": 2},
      "errors": {"maxItems": 0}
    }},
    "else": {"properties": {"variants": {"maxItems": 0}, "errors": {"minItems": 1}}}
  }],
  "$defs": {
    "nonnegative": {"type": "number", "minimum": 0},
    "timing": {
      "type": "object", "additionalProperties": false,
      "required": ["unit", "samples_ns", "median_ns", "min_ns", "max_ns", "mean_ns", "stdev_ns", "mad_ns"],
      "properties": {
        "unit": {"const": "ns"},
        "samples_ns": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "median_ns": {"$ref": "#/$defs/nonnegative"},
        "min_ns": {"$ref": "#/$defs/nonnegative"},
        "max_ns": {"$ref": "#/$defs/nonnegative"},
        "mean_ns": {"$ref": "#/$defs/nonnegative"},
        "stdev_ns": {"$ref": "#/$defs/nonnegative"},
        "mad_ns": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "function": {
      "type": "object", "additionalProperties": false,
      "required": ["filename", "line", "function", "primitive_calls", "total_calls", "self_time_seconds", "cumulative_time_seconds"],
      "properties": {
        "filename": {"type": "string"},
        "line": {"type": "integer", "minimum": 0},
        "function": {"type": "string"},
        "primitive_calls": {"type": "integer", "minimum": 0},
        "total_calls": {"type": "integer", "minimum": 0},
        "self_time_seconds": {"$ref": "#/$defs/nonnegative"},
        "cumulative_time_seconds": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "variant": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "correctness_verified", "timing", "profile"],
      "properties": {
        "name": {"type": "string"},
        "correctness_verified": {"const": true},
        "timing": {"$ref": "#/$defs/timing"},
        "profile": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/function"}}
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "variant", "type", "message"],
      "properties": {
        "phase": {"enum": ["configuration", "validation", "warmup", "timing", "profiling"]},
        "variant": {"type": "string"},
        "type": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  }
}
